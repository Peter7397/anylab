--- docker-compose.yml	2025-11-04 08:17:28
+++ docker-compose.optimized.yml	2025-11-11 08:00:00
@@ -1,61 +1,141 @@
 services:
   # PostgreSQL Database with pgvector extension
+  # OPTIMIZED: Added memory limits and PostgreSQL-specific memory tuning
   postgres:
     image: pgvector/pgvector:pg15
     container_name: anylab_postgres
+    
+    # Memory limits - PostgreSQL currently uses ~97 MB
+    deploy:
+      resources:
+        limits:
+          cpus: '1.0'        # Limit to 1 CPU core
+          memory: 256M       # Hard limit (2.6x current usage)
+        reservations:
+          memory: 128M       # Minimum guaranteed memory
+    
     environment:
       POSTGRES_DB: anylab
       POSTGRES_USER: postgres
       POSTGRES_PASSWORD: password
+      
+      # PostgreSQL Memory Optimization
+      # These settings optimize PostgreSQL for 256MB container limit
+      POSTGRES_SHARED_BUFFERS: 64MB              # 25% of container memory
+      POSTGRES_EFFECTIVE_CACHE_SIZE: 128MB      # 50% of container memory
+      POSTGRES_WORK_MEM: 4MB                     # Per-operation memory
+      POSTGRES_MAINTENANCE_WORK_MEM: 32MB       # Maintenance operations
+      POSTGRES_MAX_CONNECTIONS: 50              # Reduced from default 100
+      
     ports:
       - "5433:5432"  # Expose on 5433 to avoid conflicts with local PostgreSQL
+    
     volumes:
       - postgres_data:/var/lib/postgresql/data
+    
     restart: unless-stopped
+    
     healthcheck:
       test: ["CMD-SHELL", "pg_isready -U postgres"]
       interval: 10s
       timeout: 5s
       retries: 5
+    
     networks:
       - anylab_network
-    command: postgres -c shared_preload_libraries=vector
+    
+    command: >
+      postgres
+      -c shared_preload_libraries=vector
+      -c shared_buffers=64MB
+      -c effective_cache_size=128MB
+      -c work_mem=4MB
+      -c maintenance_work_mem=32MB
+      -c max_connections=50
+      -c random_page_cost=1.1
+      -c effective_io_concurrency=200
 
   # Redis Cache and Message Broker
+  # OPTIMIZED: Added memory limits and Redis maxmemory policy
   redis:
     image: redis:7-alpine
     container_name: anylab_redis
+    
+    # Memory limits - Redis currently uses ~13 MB
+    deploy:
+      resources:
+        limits:
+          cpus: '0.5'        # Limit to 0.5 CPU core
+          memory: 128M       # Hard limit (10x current usage)
+        reservations:
+          memory: 32M        # Minimum guaranteed memory
+    
     ports:
       - "6379:6379"
+    
     volumes:
       - redis_data:/data
+    
     restart: unless-stopped
+    
     healthcheck:
       test: ["CMD", "redis-cli", "ping"]
       interval: 10s
       timeout: 3s
       retries: 5
+    
     networks:
       - anylab_network
-    command: redis-server --appendonly yes
+    
+    # Redis memory optimization
+    command: >
+      redis-server
+      --appendonly yes
+      --maxmemory 100mb
+      --maxmemory-policy allkeys-lru
+      --save 900 1
+      --save 300 10
+      --save 60 10000
 
   # Neo4j Graph Database
+  # OPTIMIZED: Reduced memory allocation from 3GB to 1.5GB (heap + pagecache)
+  # Currently using 1.466 GB, new limit 2 GB provides 36% headroom
   neo4j:
     image: neo4j:5.15-community
     container_name: anylab_neo4j
+    
+    # Memory limits - Neo4j currently uses ~1.466 GB
+    deploy:
+      resources:
+        limits:
+          cpus: '2.0'        # Limit to 2 CPU cores
+          memory: 2G         # Hard limit (36% headroom over current usage)
+        reservations:
+          memory: 1G         # Minimum guaranteed memory
+    
     ports:
       - "7474:7474"   # HTTP - Neo4j Browser
       - "7687:7687"   # Bolt protocol - Python driver
+    
     environment:
       # Authentication (change password in production!)
       - NEO4J_AUTH=neo4j/anylab_neo4j_password
       
-      # Memory settings (adjust based on your system)
-      - NEO4J_dbms_memory_heap_initial__size=512m
-      - NEO4J_dbms_memory_heap_max__size=2G
-      - NEO4J_dbms_memory_pagecache_size=1G
+      # OPTIMIZED Memory settings for resource-constrained environments
+      # Reduced from: heap_max=2G, pagecache=1G (total 3GB)
+      # New settings: heap_max=1G, pagecache=512M (total 1.5GB)
+      - NEO4J_dbms_memory_heap_initial__size=256m     # Start with 256MB (was 512m)
+      - NEO4J_dbms_memory_heap_max__size=1G           # Max 1GB heap (was 2G) - 50% reduction
+      - NEO4J_dbms_memory_pagecache_size=512m         # 512MB pagecache (was 1G) - 50% reduction
       
-      # Optional: Enable APOC library for advanced procedures
+      # Transaction settings for memory efficiency
+      - NEO4J_dbms_memory_transaction_total_max=768m  # Limit transaction memory
+      - NEO4J_dbms_memory_transaction_max=384m        # Per-transaction limit
+      
+      # Query memory limits
+      - NEO4J_dbms_memory_transaction_global__max__size=768m
+      
+      # Enable APOC library for advanced procedures
       - NEO4J_PLUGINS=["apoc"]
       
       # Allow Bolt connections from anywhere (change for production)
@@ -65,6 +145,10 @@
       # Security settings
       - NEO4J_dbms_security_procedures_unrestricted=apoc.*
       
+      # Performance tuning for lower memory
+      - NEO4J_dbms_checkpoint_interval_time=15m
+      - NEO4J_dbms_checkpoint_interval_tx=100000
+      
     volumes:
       # Persist data
       - neo4j_data:/data
@@ -102,3 +186,17 @@
   anylab_network:
     driver: bridge
 
